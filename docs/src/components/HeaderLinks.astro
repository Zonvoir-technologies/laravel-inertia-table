---
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';

const links = config.social || [];
---

<nav class="zv-top-links" aria-label="Primary">
  <a href="https://demo.zonvoir-table.com" target="_blank" rel="noopener noreferrer">Demo</a>
  <a href="/getting-started/introduction/">Docs</a>
</nav>

{
  links.length > 0 && (
    <div class="zv-social-links">
      {links.map(({ label, href, icon }) => (
        <a {href} rel="me" class="sl-flex">
          <span class="sr-only">{label}</span>
          <Icon name={icon} />
        </a>
      ))}
    </div>
  )
}